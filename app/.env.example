# MiraiStitch — environment
# Copy to .env.local and fill in. Never commit .env.local.
# Every variable below is actually read somewhere in src/; nothing here is decorative.

# ── Supabase (required) ───────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row-Level Security — it is the key that lets the
# checkout, the PayFast webhook and the credit functions write on behalf of a
# tenant. Never expose it to the browser and never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site (required) ───────────────────────────────────────────────
# Used to build PayFast return/cancel/notify URLs, so it must be reachable by
# PayFast. For local ITN testing use a tunnel (npx localtunnel --port 3000)
# and put the tunnel URL here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── PayFast (sandbox values work out of the box) ──────────────────
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
# Leave empty in sandbox unless you set one in the PayFast dashboard.
# In live, this MUST match the dashboard exactly or every signature fails.
PAYFAST_PASSPHRASE=

# ── AI text tools (optional) ──────────────────────────────────────
# Without this, /api/ai/describe, /api/ai/seo and /api/ai/generate return 501
# and the buttons show a clear "not configured" message. Nothing breaks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Product-shot generation (optional, PAID feature) ──────────────
# The Anthropic API does not generate or edit images, so background removal
# needs a separate provider. Leave unset and /api/ai/enhance returns 501 and
# charges no credits. See src/lib/ai/imageProvider.ts.
IMAGE_PROVIDER=
REPLICATE_API_TOKEN=
REPLICATE_BGREMOVE_VERSION=

# ── Order receipts (optional) ─────────────────────────────────────
# Unset = the webhook silently skips the email; the order still completes.
RESEND_API_KEY=
RESEND_FROM=MiraiStitch <onboarding@resend.dev>
