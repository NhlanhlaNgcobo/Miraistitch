!**/.env.example

# build artefacts
.next/
out/
*.tsbuildinfo

# large source photography — the web-sized WebP in images/products/w/ is what
# the pages actually load (23.4 MB of PNG vs 1.28 MB of WebP)
images/products/*.png
app/public/images/products/*.png
